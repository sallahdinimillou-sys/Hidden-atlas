rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Activities and tours collection and detail images subcollection
    match /activities/{activityId} {
      allow read: if true;
      allow write: if true;

      match /images/{imageId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // Bookings collection (Traveler reservations)
    match /bookings/{bookingId} {
      allow read, write: if true;
    }

    // Inquiries collection (Contact and inquiry messages)
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Settings collection (WhatsApp, social media links, guide settings)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
